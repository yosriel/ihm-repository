# Copia este archivo como .env y completa ambas contraseñas con valores propios.
# No uses comillas alrededor de los valores al importar con el ejemplo PowerShell.
# Si una contraseña contiene $, escribe $$ en .env para Docker Compose y define
# DB_PASSWORD directamente en PowerShell con su valor original para Spring Boot.
DB_URL=jdbc:mysql://localhost:3307/falabella_ihm
DB_USERNAME=ihm_app
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
FRONTEND_ORIGINS=http://localhost:5173
PORT=8080
